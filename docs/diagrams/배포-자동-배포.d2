vars: {
  d2-config: { layout-engine: dagre }
}

classes: {
  step: { style: { border-radius: 8; fill: "#F4F6FA"; stroke: "#5B6B8C" } }
  ask:  { style: { border-radius: 24; fill: "#FFF7E0"; stroke: "#C99A2E" } }
  fail: { style: { border-radius: 8; fill: "#FDECEC"; stroke: "#C0392B"; font-color: "#8E2A20" } }
  ok:   { style: { border-radius: 8; fill: "#E8F6EE"; stroke: "#2E8B57"; font-color: "#1E6B41" } }
  ext:  { style: { border-radius: 8; fill: "#EEF3FB"; stroke: "#3F6FB5" } }
}

direction: right
a: "PR·develop·main 푸시" { class: step }
a2: "문서 ID 검사" { class: step }
b: "빌드·테스트 H2\nArchUnit 포함\n동시 참여 테스트는 MySQL 컨테이너" { class: step }
d: "main 병합인가" { class: ask }
z: "종료" { class: step }
e: "Docker 이미지 빌드\nGHCR 푸시, 태그=커밋 SHA" { class: step }
f: "EC2에 SSH 접속\n새 이미지로 컨테이너 교체" { class: step }
g: "헬스 체크 통과" { class: ask }
h: "배포 완료" { class: ok }
r: "직전 이미지 태그로 롤백" { class: fail }
a -> a2 -> b -> d
d -> z: 아니오
d -> e: 예
e -> f -> g
g -> h: 예
g -> r: 아니오
