vars: {
  d2-config: { layout-engine: dagre }
}

classes: {
  step: { style: { border-radius: 8; fill: "#F4F6FA"; stroke: "#5B6B8C" } }
  ask:  { style: { border-radius: 24; fill: "#FFF7E0"; stroke: "#C99A2E" } }
  fail: { style: { border-radius: 8; fill: "#FDECEC"; stroke: "#C0392B"; font-color: "#8E2A20" } }
  ok:   { style: { border-radius: 8; fill: "#E8F6EE"; stroke: "#2E8B57"; font-color: "#1E6B41" } }
  ext:  { style: { border-radius: 8; fill: "#EEF3FB"; stroke: "#3F6FB5" } }
}

direction: right
u: "브라우저" { class: step }
v: "Vercel 프런트" { class: ext }
ec2: "앱 EC2" {
  c: "Caddy" { class: step }
  s: "Spring Boot 컨테이너" { class: step }
  c -> s
}
r: "RDS MySQL 8.4" { shape: cylinder }
k: "카카오" { class: ext }
mon: "모니터링 EC2" {
  p: "Prometheus" { class: step }
  g: "Grafana" { class: step }
  p -> g
}
dc: "디스코드 웹훅" { class: ext }
u -> v: "도메인, www"
u -> ec2.c: "api 서브도메인 HTTPS"
ec2.s -> r
ec2.s -> k: "토큰 교환"
mon.p -> ec2.s: "사설 IP로 Actuator 수집" { style.stroke-dash: 4 }
mon.g -> dc
