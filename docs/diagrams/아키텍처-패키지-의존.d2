vars: {
  d2-config: { layout-engine: dagre }
}

classes: {
  step: { style: { border-radius: 8; fill: "#F4F6FA"; stroke: "#5B6B8C" } }
  ask:  { style: { border-radius: 24; fill: "#FFF7E0"; stroke: "#C99A2E" } }
  fail: { style: { border-radius: 8; fill: "#FDECEC"; stroke: "#C0392B"; font-color: "#8E2A20" } }
  ok:   { style: { border-radius: 8; fill: "#E8F6EE"; stroke: "#2E8B57"; font-color: "#1E6B41" } }
  ext:  { style: { border-radius: 8; fill: "#EEF3FB"; stroke: "#3F6FB5" } }
}

direction: down
admin: admin { class: step }
report: report { class: step }
vote: vote { class: step }
poll: poll { class: step }
auth: auth { class: step }
member: member { class: step }
support: "support\nanon·config·error·jpa·logging·stereotype·web" { class: ext }

admin -> report
admin -> poll
admin -> member
report -> poll
vote -> poll
poll -> member
vote -> member
report -> member
auth -> member
poll -> support
vote -> support
report -> support
admin -> support
auth -> support
member -> support
