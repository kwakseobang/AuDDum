vars: {
  d2-config: { layout-engine: dagre }
}

classes: {
  step: { style: { border-radius: 8; fill: "#F4F6FA"; stroke: "#5B6B8C" } }
  ask:  { style: { border-radius: 24; fill: "#FFF7E0"; stroke: "#C99A2E" } }
  fail: { style: { border-radius: 8; fill: "#FDECEC"; stroke: "#C0392B"; font-color: "#8E2A20" } }
  ok:   { style: { border-radius: 8; fill: "#E8F6EE"; stroke: "#2E8B57"; font-color: "#1E6B41" } }
  ext:  { style: { border-radius: 8; fill: "#EEF3FB"; stroke: "#3F6FB5" } }
}

direction: right
s: "시작" { class: step }
PENDING: "PENDING\n검토 대기" { class: ask }
RESOLVED: "RESOLVED\n처리됨(끝)" { class: ok }
DISMISSED: "DISMISSED\n기각됨(끝)" { class: step }

s -> PENDING: 신고 접수
PENDING -> RESOLVED: 투표 숨김·삭제 시 일괄 종료
PENDING -> DISMISSED: 기각
