  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/admin/members/{memberId}/suspend" : {
      "post" : {
        "description" : "정상 회원을 정지한다. 기간 없이 해제할 때까지 유지되고, 그 회원의 기존 투표와 신고 상태는 바꾸지 않는다.",
        "operationId" : "suspendMember",
        "parameters" : [ {
          "description" : "회원 내부 id",
          "example" : 5,
          "in" : "path",
          "name" : "memberId",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AdminReasonRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "정지됨"
          },
          "400" : {
            "description" : "VALIDATION_FAILED: 사유 규칙 위반, MALFORMED_REQUEST: 회원 ID 형식 오류·본문 형식 오류"
          },
          "401" : {
            "description" : "UNAUTHENTICATED"
          },
          "403" : {
            "description" : "FORBIDDEN: 관리자가 아님(정지·탈퇴한 관리자 포함)"
          },
          "404" : {
            "description" : "MEMBER_NOT_FOUND"
          },
          "409" : {
            "description" : "MEMBER_NOT_ACTIVE: 이미 정지·탈퇴한 회원"
          }
        },
        "summary" : "회원 정지",
        "tags" : [ "관리자 회원" ]
      }
    },
    "/api/v1/admin/polls/{pollId}/status" : {
      "patch" : {
        "description" : "투표를 숨기거나(HIDDEN) 삭제하고(DELETED) 그 투표의 대기 신고를 모두 조치 완료로 종료한다. 상태 변경, 신고 종료, 이력 기록은 한 트랜잭션이다. 숨김은 공개 투표만 가능하고 복구할 수 있다. 삭제는 공개·숨김 투표에서 가능하고 복구할 수 없다.",
        "operationId" : "takedownPoll",
        "parameters" : [ {
          "description" : "투표 공개 ID(12자 영숫자)",
          "example" : "aB3dE5fG7hJk",
          "in" : "path",
          "name" : "pollId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AdminPollTakedownRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "조치됨"
          },
          "400" : {
            "description" : "VALIDATION_FAILED: 상태 누락·사유 규칙 위반, MALFORMED_REQUEST: 투표 ID 형식 오류·본문 형식 오류·허용되지 않은 상태 값"
          },
          "401" : {
            "description" : "UNAUTHENTICATED"
          },
          "403" : {
            "description" : "FORBIDDEN: 관리자가 아님(정지·탈퇴한 관리자 포함)"
          },
          "404" : {
            "description" : "POLL_NOT_FOUND: 없거나 삭제된 투표"
          },
          "409" : {
            "description" : "POLL_NOT_PUBLIC: 이미 숨겨진 투표를 숨기려 했다"
          }
        },
        "summary" : "투표 숨김·삭제",
        "tags" : [ "관리자 투표" ]
      }
    },
    "/api/v1/admin/reports" : {
      "get" : {
        "description" : "상태별(기본 PENDING) 신고를 접수 순(id 오름차순)으로 내린다. 각 항목에 같은 투표에 쌓인 신고 수(pollReportCount)가 있다. cursor는 이전 응답의 nextCursor를 그대로 넘기는 불투명한 값이다.",
        "operationId" : "getReports",
        "parameters" : [ {
          "description" : "신고 상태. 기본 PENDING",
          "example" : "PENDING",
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "이전 응답의 nextCursor. 없으면 첫 페이지",
          "in" : "query",
          "name" : "cursor",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "한 페이지 개수. 기본 20, 1보다 작으면 1, 50을 넘으면 50으로 보정",
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
